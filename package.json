{
  "name": "hexray",
  "version": "0.1.0",
  "description": "Architecture audit CLI for hexagonal/DDD codebases (TypeScript & Kotlin)",
  "type": "module",
  "license": "MIT",
  "author": "Riadh MNASRI",
  "bin": {
    "hexray": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup src/presentation/cli.ts --format esm --dts --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "architecture",
    "audit",
    "hexagonal",
    "ddd",
    "cli",
    "static-analysis"
  ],
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/node": "^20.14.0",
    "eslint": "^9.9.0",
    "tsup": "^8.2.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "dependency-cruiser": "^18.1.0"
  }
}
